  "artifacts": {
    "generated_tests.keel": "// Add regression tests here.\n\ntest \"equal timestamps are never fresh\" {\n    assert !is_fresh(0, 0)\n    assert !is_fresh(1, 1)\n    assert !is_fresh(-1, -1)\n    assert !is_fresh(9223372036854775807, 9223372036854775807)\n    assert !is_fresh(-9223372036854775807 - 1, -9223372036854775807 - 1)\n}\n\ntest \"adjacent timestamps preserve strict ordering\" {\n    assert is_fresh(0, 1)\n    assert !is_fresh(1, 0)\n    assert is_fresh(-1, 0)\n    assert !is_fresh(0, -1)\n    assert is_fresh(-2, -1)\n    assert !is_fresh(-1, -2)\n    assert is_fresh(41, 42)\n    assert !is_fresh(42, 41)\n    assert is_fresh(-42, -41)\n    assert !is_fresh(-41, -42)\n}\n\ntest \"ordering at signed timestamp limits\" {\n    let minimum = -9223372036854775807 - 1\n    let maximum = 9223372036854775807\n    assert is_fresh(minimum, minimum + 1)\n    assert !is_fresh(minimum + 1, minimum)\n    assert is_fresh(maximum - 1, maximum)\n    assert !is_fresh(maximum, maximum - 1)\n    assert is_fresh(minimum, maximum)\n    assert !is_fresh(maximum, minimum)\n    assert is_fresh(minimum, 0)\n    assert !is_fresh(0, minimum)\n    assert is_fresh(-1, maximum)\n    assert !is_fresh(maximum, -1)\n    assert is_fresh(0, maximum)\n    assert !is_fresh(maximum, 0)\n}\n\ntest \"signed ordering across wide gaps\" {\n    assert is_fresh(-1, 1)\n    assert !is_fresh(1, -1)\n    assert is_fresh(-7000000000000000000, 7000000000000000000)\n    assert !is_fresh(7000000000000000000, -7000000000000000000)\n    assert is_fresh(-7000000000000000000, -3000000000000000000)\n    assert !is_fresh(-3000000000000000000, -7000000000000000000)\n    assert is_fresh(3000000000000000000, 7000000000000000000)\n    assert !is_fresh(7000000000000000000, 3000000000000000000)\n}\n\ntest \"ordering retains timestamp bits above 32 bits\" {\n    assert is_fresh(2147483647, 2147483648)\n    assert !is_fresh(2147483648, 2147483647)\n    assert is_fresh(-2147483649, -2147483648)\n    assert !is_fresh(-2147483648, -2147483649)\n    assert is_fresh(1, 4294967297)\n    assert !is_fresh(4294967297, 1)\n    assert is_fresh(-4294967297, -1)\n    assert !is_fresh(-1, -4294967297)\n}\n"
  },
