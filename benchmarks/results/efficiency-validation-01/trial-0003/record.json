  "artifacts": {
    "generated_tests.keel": "// Add regression tests here.\n\ntest \"equal timestamps are never fresh\" {\n    assert !is_fresh(0, 0)\n    assert !is_fresh(1, 1)\n    assert !is_fresh(-1, -1)\n    assert !is_fresh(-9223372036854775807 - 1, -9223372036854775807 - 1)\n    assert !is_fresh(9223372036854775807, 9223372036854775807)\n}\n\ntest \"adjacent timestamps preserve strict ordering\" {\n    assert is_fresh(0, 1)\n    assert !is_fresh(1, 0)\n    assert is_fresh(-1, 0)\n    assert !is_fresh(0, -1)\n    assert is_fresh(-2, -1)\n    assert !is_fresh(-1, -2)\n    assert is_fresh(41, 42)\n    assert !is_fresh(42, 41)\n    assert is_fresh(-42, -41)\n    assert !is_fresh(-41, -42)\n}\n\ntest \"signed extrema and their neighbors\" {\n    let minimum = -9223372036854775807 - 1\n    let maximum = 9223372036854775807\n    assert is_fresh(minimum, minimum + 1)\n    assert !is_fresh(minimum + 1, minimum)\n    assert is_fresh(maximum - 1, maximum)\n    assert !is_fresh(maximum, maximum - 1)\n    assert is_fresh(minimum, maximum)\n    assert !is_fresh(maximum, minimum)\n    assert is_fresh(minimum, 0)\n    assert !is_fresh(0, minimum)\n    assert is_fresh(-1, maximum)\n    assert !is_fresh(maximum, -1)\n    assert is_fresh(minimum, -1)\n    assert !is_fresh(-1, minimum)\n    assert is_fresh(0, maximum)\n    assert !is_fresh(maximum, 0)\n}\n\ntest \"ordering matrix spans signs and integer widths\" {\n    let timestamps = [\n        -9223372036854775807 - 1,\n        -9223372036854775807,\n        -4611686018427387904,\n        -4294967296,\n        -2147483649,\n        -2147483648,\n        -65536,\n        -256,\n        -42,\n        -2,\n        -1,\n        0,\n        1,\n        2,\n        42,\n        255,\n        256,\n        65536,\n        2147483647,\n        2147483648,\n        4294967296,\n        4611686018427387904,\n        9223372036854775806,\n        9223372036854775807\n    ]\n    var now_index = 0\n    for now in timestamps {\n        var deadline_index = 0\n        for deadline in timestamps {\n            assert is_fresh(now, deadline) == (now_index < deadline_index)\n            deadline_index = deadline_index + 1\n        }\n        now_index = now_index + 1\n    }\n}\n"
  },
