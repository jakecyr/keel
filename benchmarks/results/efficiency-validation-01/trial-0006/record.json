  "artifacts": {
    "generated_tests.keel": "// Add regression tests here.\n\ntest \"equal timestamps are never fresh\" {\n    assert is_fresh(0, 0) == false\n    assert is_fresh(1, 1) == false\n    assert is_fresh(-1, -1) == false\n    assert is_fresh(9223372036854775807, 9223372036854775807) == false\n    assert is_fresh(-9223372036854775807 - 1, -9223372036854775807 - 1) == false\n}\n\ntest \"adjacent timestamps obey strict ordering\" {\n    assert is_fresh(0, 1)\n    assert is_fresh(1, 0) == false\n    assert is_fresh(-1, 0)\n    assert is_fresh(0, -1) == false\n    assert is_fresh(-2, -1)\n    assert is_fresh(-1, -2) == false\n    assert is_fresh(41, 42)\n    assert is_fresh(42, 41) == false\n    assert is_fresh(-42, -41)\n    assert is_fresh(-41, -42) == false\n}\n\ntest \"extreme adjacent timestamps preserve ordering\" {\n    let lowest = -9223372036854775807 - 1\n    let highest = 9223372036854775807\n    assert is_fresh(lowest, lowest + 1)\n    assert is_fresh(lowest + 1, lowest) == false\n    assert is_fresh(highest - 1, highest)\n    assert is_fresh(highest, highest - 1) == false\n}\n\ntest \"wide signed differences preserve ordering\" {\n    let lowest = -9223372036854775807 - 1\n    let highest = 9223372036854775807\n    assert is_fresh(lowest, highest)\n    assert is_fresh(highest, lowest) == false\n    assert is_fresh(lowest, 0)\n    assert is_fresh(0, lowest) == false\n    assert is_fresh(-1, highest)\n    assert is_fresh(highest, -1) == false\n    assert is_fresh(0, highest)\n    assert is_fresh(highest, 0) == false\n    assert is_fresh(lowest, -1)\n    assert is_fresh(-1, lowest) == false\n    assert is_fresh(-123456789, 987654321)\n    assert is_fresh(987654321, -123456789) == false\n}\n\ntest \"ordering retains bits above 32 bit range\" {\n    assert is_fresh(2147483647, 2147483648)\n    assert is_fresh(2147483648, 2147483647) == false\n    assert is_fresh(-2147483649, -2147483648)\n    assert is_fresh(-2147483648, -2147483649) == false\n    assert is_fresh(1, 4294967297)\n    assert is_fresh(4294967297, 1) == false\n    assert is_fresh(-4294967297, -1)\n    assert is_fresh(-1, -4294967297) == false\n    assert is_fresh(9007199254740992, 9007199254740993)\n    assert is_fresh(9007199254740993, 9007199254740992) == false\n    assert is_fresh(-9007199254740993, -9007199254740992)\n    assert is_fresh(-9007199254740992, -9007199254740993) == false\n}\n"
  },
