// State: x, y, vx, vy, left_y, right_y, left_score, right_score, tick.
// Units are fixed point screen coordinates; one tick represents 1/30 second.
fn initial_state() -> List<Int> { return [500, 300, 8, 5, 300, 300, 0, 0, 0] }
fn clamp(value: Int, minimum: Int, maximum: Int) -> Int {
    if value < minimum { return minimum }
    if value > maximum { return maximum }
    return value
}
fn step(state: read List<Int>, left: Int, right: Int) -> List<Int>
requires list.len(state) == 9
requires left >= -1 && left <= 1 && right >= -1 && right <= 1
{
    var x = list.at(state, 0) + list.at(state, 2)
    var y = list.at(state, 1) + list.at(state, 3)
    var vx = list.at(state, 2)
    var vy = list.at(state, 3)
    let ly = clamp(list.at(state, 4) + left * 9, 55, 545)
    let ry = clamp(list.at(state, 5) + right * 9, 55, 545)
    var ls = list.at(state, 6)
    var rs = list.at(state, 7)
    if y < 8 { y = 16 - y vy = 0 - vy }
    if y > 592 { y = 1184 - y vy = 0 - vy }
    if vx < 0 && list.at(state, 0) >= 38 && x <= 38 && y >= ly - 63 && y <= ly + 63 {
        x = 76 - x vx = 0 - vx vy = clamp((y - ly) / 8, -8, 8)
        if vy == 0 { vy = 2 }
    }
    if vx > 0 && list.at(state, 0) <= 962 && x >= 962 && y >= ry - 63 && y <= ry + 63 {
        x = 1924 - x vx = 0 - vx vy = clamp((y - ry) / 8, -8, 8)
        if vy == 0 { vy = -2 }
    }
    if x < -8 { rs = rs + 1 x = 500 y = 300 vx = 8 vy = 5 }
    if x > 1008 { ls = ls + 1 x = 500 y = 300 vx = -8 vy = -5 }
    return [x, y, vx, vy, ly, ry, ls, rs, list.at(state, 8) + 1]
}
fn offline_action(state: read List<Int>, player: Int) -> Int {
    let paddle = list.at(state, 4 + player)
    let target = list.at(state, 1)
    if target < paddle - 22 { return -1 }
    if target > paddle + 22 { return 1 }
    return 0
}
fn encode_state(state: read List<Int>) -> Text {
    var encoded = "["
    var i = 0
    while i < list.len(state) {
        if i > 0 { encoded = text.concat(encoded, ",") }
        encoded = text.concat(encoded, text.from_int(list.at(state, i)))
        i = i + 1
    }
    return text.concat(encoded, "]")
}
fn number(job: read Text, path: read Text) -> Int {
    match json.int(job, path) {
        Ok(value) => { return value }
        Err(_error) => { assert false return 0 }
    }
}
// Geometry is observation only. In live mode Jev still selects the target.
fn incoming(state: read List<Int>, side: Int) -> Bool {
    if side == 0 { return list.at(state, 2) < 0 }
    return list.at(state, 2) > 0
}
fn impact_ticks(state: read List<Int>, side: Int) -> Int {
    if !incoming(state, side) { return 0 }
    var distance = 962 - list.at(state, 0)
    var speed = list.at(state, 2)
    if side == 0 { distance = list.at(state, 0) - 38 speed = 0 - speed }
    if distance < 0 { return 0 }
    return (distance + speed - 1) / speed
}
fn predicted_impact(state: read List<Int>, side: Int) -> Int {
    let raw = list.at(state, 1) + list.at(state, 3) * impact_ticks(state, side) - 8
    var folded = raw % 1168
    if folded < 0 { folded = folded + 1168 }
    if folded > 584 { return 1176 - folded }
    return 8 + folded
}
fn legal_target(target: Int) -> Bool { return target >= 55 && target <= 545 && (target - 55) % 49 == 0 }
fn offline_target(state: read List<Int>, side: Int) -> Int {
    return 55 + ((clamp(predicted_impact(state, side), 55, 545) - 55 + 24) / 49) * 49
}
fn target_action(paddle: Int, target: Int) -> Int {
    if target < paddle - 4 { return -1 }
    if target > paddle + 4 { return 1 }
    return 0
}
